# ---------------------------------------------------------------------------
# [조각(fragment) - 파일 전체가 아님] db-active Oracle XE sqlnet.ora
#   실제 위치 : 호스트 /oradata/dbconfig/XE/sqlnet.ora
#               (= 컨테이너 /opt/oracle/oradata/dbconfig/XE/sqlnet.ora,
#                  /opt/oracle/homes/OraDBHome21cXE/network/admin/sqlnet.ora 가 이 파일을 가리키는 링크)
#   권한      : 600 oracle:oinstall (54321:54321)
#   원본 크기 : 286바이트(9/30 01:27 UTC 수정, 10/2 앱 서버 2대 추가 전 기준). 주석 줄이 있으나 내용 미확보.
#   아래 3줄만 근거로 확인된 '주석이 아닌' 설정이다. 나머지 내용은 확인하지 못했다(TODO 확인필요).
#   근거
#     - tcp.validnode_checking / tcp.invited_nodes : wf_1001.json D-10(10/1 컨테이너 안 조회),
#       rfix4_db-active/dbms.out D-10(10/2 조치 후), apply_scripts/db-active/fix_invited_nodes.sh(10/2 장애 조치 sed 패턴),
#       report_1002/조치결과_보고_20261002.md 3장(장애 기록)
#     - SQLNET.ALLOWED_LOGON_VERSION_SERVER : wf_1001.json D-08, rfix4_db-active/dbms.out D-08
#   10/2 11:16 장애 조치로 10.0.10.52(was-adm1), 10.0.10.174(was1)가 추가됐다. 이 두 IP가 빠지면 앱 DB 연결이 거부된다.
# ---------------------------------------------------------------------------
tcp.validnode_checking = yes
tcp.invited_nodes = (127.0.0.1, 10.0.20.0/24, 10.0.10.52, 10.0.10.174, <ADMIN_IP>, <TEAM_IP_3>)
SQLNET.ALLOWED_LOGON_VERSION_SERVER = 12a
