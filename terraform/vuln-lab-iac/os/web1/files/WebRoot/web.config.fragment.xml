  - 운영 원본: 2,118 bytes, 마지막 수정 2026-09-29 00:57 UTC. 원문은 확보하지 못했다.
  - 이 파일에는 진단 증거에 나온 설정만 넣었다. 나머지는 모른다.
    * 규칙 HttpsRedirect / ReverseProxy 의 이름·조건·동작
        근거: infra_diag_0929/wf_result_v2.json web1 WEB-10·WEB-21,
              results/apply/web1/20261002-111213_W-18_health.log (appcmd 출력)
    * ReverseProxy 의 stopProcessing                       근거: wf_result_v2.json web1 WEB-07
    * customHeaders <remove name="X-Powered-By"/>          근거: wf_result_v2.json web1 WEB-16
    * httpErrors errorMode=Custom, <clear/>, 400·401·403·404·405·500·502 → error.html(File)
                                                            근거: wf_result_v2.json web1 WEB-22
  - 모르는 부분: 속성 순서, serverVariables 사용 여부, HttpsRedirect 의 stopProcessing,
    error 요소의 path 표기 방식, 그 밖의 섹션. 원본을 확보하면 이 파일을 원본으로 바꾼다.
  - 서버 수준(applicationHost.config) 설정은 baseline.ps1 이 따로 넣는다
    (ARR proxy enabled/preserveHostHeader, removeServerHeader, location 의 existingResponse=PassThrough).
  - 백엔드 주소: in-alb 의 DNS 이름. in-alb 를 다시 만들면 이 이름이 바뀌므로 함께 고친다.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- ALB 가 넘긴 X-Forwarded-Proto 가 http 이면 https 로 301 -->
        <rule name="HttpsRedirect">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^http$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- 모든 요청을 내부 ALB(in-alb, HTTPS 443 → tg-was 8080)로 역방향 프록시 -->
        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="https://internal-in-alb-1262980660.ap-northeast-2.elb.amazonaws.com:443/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="Custom">
      <clear />
      <error statusCode="400" path="error.html" responseMode="File" />
      <error statusCode="401" path="error.html" responseMode="File" />
      <error statusCode="403" path="error.html" responseMode="File" />
      <error statusCode="404" path="error.html" responseMode="File" />
      <error statusCode="405" path="error.html" responseMode="File" />
      <error statusCode="500" path="error.html" responseMode="File" />
      <error statusCode="502" path="error.html" responseMode="File" />
    </httpErrors>
  </system.webServer>
</configuration>
