SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
ORACLE_URL=jdbc:oracle:thin:@db.example.internal:1521/FREEPDB1
ORACLE_USERNAME=clinic
ORACLE_PASSWORD=change-me-with-a-secret-manager
APP_BASE_URL=https://admin.example.co.kr
APP_UPLOAD_DIR=/var/clinic/uploads
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me-with-an-app-password
APP_RECORDS_DIR=/var/clinic/records
# 실제 관리자 공인 IP/VPN 대역으로 교체. VPC 전체나 0.0.0.0/0은 금지.
ADMIN_ALLOWED_NETWORKS=203.0.113.10/32,198.51.100.0/24
FORWARD_HEADERS_STRATEGY=native
# 기존 admin/user 테스트 계정 교체 시 한 번만 true로 기동하고 즉시 제거한다.
ROTATE_PASSWORDS_ON_STARTUP=false
ROTATE_ADMIN_PASSWORD=replace-with-a-unique-strong-password
ROTATE_USER_PASSWORD=replace-with-a-different-unique-strong-password
RECORD_DOWNLOAD_KEY=generate-at-least-32-random-bytes
REQUIRE_HTTPS=true
